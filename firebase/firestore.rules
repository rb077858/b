rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'rb077858@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // הגדרות ציבוריות של כל פרויקט במאגר (קריאה לכולם, כתיבה לאדמין בלבד)
    match /sites/{site} {
      allow read: if true;
      allow write: if isAdmin();

      // היסטוריית גרסאות - אדמין בלבד
      match /history/{entry} {
        allow read, write: if isAdmin();
      }
    }

    // =================================================================
    //  שותפים לחדר (bchira) - אוספים שמתחילים ב-rm_
    // =================================================================
    function signedIn() {
      return request.auth != null;
    }
    function myUserPath() {
      return /databases/$(database)/documents/rm_users/$(request.auth.uid);
    }
    function myUser() {
      return get(myUserPath()).data;
    }
    // משתמש פעיל: אדמין, או מי שנרשם ואינו חסום
    function active() {
      return isAdmin()
        || (signedIn() && exists(myUserPath()) && myUser().get('blocked', false) != true);
    }
    function validQid(q) {
      return q in ['sleep', 'wake', 'tidy', 'noise', 'temp', 'study', 'guests', 'food', 'night', 'share'];
    }

    // הגדרה ציבורית: האם ההרשמה פתוחה
    match /rm_public/{d} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // קוד ההזמנה - רק אדמין קורא וכותב. החוקים בודקים אותו בעצמם בזמן הרשמה
    match /rm_secret/{d} {
      allow read, write: if isAdmin();
    }

    // משתמשים (חשבון Google). כל משתמש רואה רק את עצמו
    match /rm_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.blocked == false
            && request.resource.data.first is string
            && request.resource.data.first.size() >= 1 && request.resource.data.first.size() <= 30
            && request.resource.data.last is string
            && request.resource.data.last.size() >= 1 && request.resource.data.last.size() <= 30
            && request.resource.data.pid is string
            && request.resource.data.picks is list && request.resource.data.picks.size() == 0
            && get(/databases/$(database)/documents/rm_public/config).data.open == true
            && request.resource.data.code == get(/databases/$(database)/documents/rm_secret/invite).data.code);
      // המשתמש יכול לעדכן רק רשימת בחירות ומשקלים. חסימה ושם רק אדמין
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && active()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['picks', 'w', 'lastSeen'])
            && request.resource.data.picks.size() <= 5);
      allow delete: if isAdmin();
    }

    // אנשים בשכבה (גם כאלה שעוד לא נכנסו). eff/conf/n הם התשובות המחושבות
    match /rm_people/{pid} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.merged == false
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 62;
      allow update: if isAdmin()
        || (active()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eff', 'conf', 'n', 'effAt']));
      allow delete: if isAdmin();
    }

    // טענות: מי ענה מה על מי. מזהה המסמך = pid_qid_uid
    match /rm_claims/{cid} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.author == request.auth.uid
        && request.resource.data.pid is string
        && validQid(request.resource.data.qid)
        && cid == request.resource.data.pid + '_' + request.resource.data.qid + '_' + request.auth.uid
        && request.resource.data.v is int
        && request.resource.data.v >= 0 && request.resource.data.v <= 3
        && request.resource.data.t is number
        && request.resource.data.self is bool
        && (request.resource.data.self == false || myUser().pid == request.resource.data.pid)
        && request.resource.data.get('ignored', false) == false;
      allow update: if isAdmin()
        || (active()
            && resource.data.author == request.auth.uid
            && request.resource.data.author == request.auth.uid
            && request.resource.data.pid == resource.data.pid
            && request.resource.data.qid == resource.data.qid
            && request.resource.data.v is int
            && request.resource.data.v >= 0 && request.resource.data.v <= 3
            && request.resource.data.t is number
            && request.resource.data.self is bool
            && (request.resource.data.self == false || myUser().pid == request.resource.data.pid)
            && request.resource.data.get('ignored', false) == resource.data.get('ignored', false));
      allow delete: if isAdmin();
    }

    // הכרעות אדמין לסתירות ועריכות. אדמין בלבד כותב
    match /rm_resolved/{rid} {
      allow read: if active();
      allow write: if isAdmin();
    }

    // =================================================================
    //  מחולל הממים (memes) - כל אחד יכול לשלוח מם, רק אדמין רואה/עורך/מוחק
    //  נשמרים רק הקישור לתמונה של memeking והטקסטים
    // =================================================================
    function memeImg(u) {
      // כל תו ASCII מודפס (יש קישורים עם %2F, סוגריים וכו'), רק מהדלי של memeking
      return u is string && u.size() <= 1000
        && u.matches('https://storage[.]googleapis[.]com/meme-king-storage/[!-~]+');
    }
    // מיקום טקסט שנגרר: מרכז הבלוק כשבר מגודל התמונה
    function validPos(p) {
      return p is map && p.keys().hasOnly(['x', 'y']) && p.keys().hasAll(['x', 'y'])
        && p.x is number && p.y is number
        && p.x >= 0 && p.x <= 1 && p.y >= 0 && p.y <= 1;
    }
    function str(v, max) {
      return v is string && v.size() <= max;
    }
    match /memes/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['imageUrl', 'thumbUrl', 'sourceId', 'category', 'sourceDesc', 'top', 'bottom', 'size', 'status', 'createdAt', 'topPos', 'bottomPos'])
        && request.resource.data.keys().hasAll(['imageUrl', 'top', 'bottom', 'size', 'status', 'createdAt'])
        && memeImg(request.resource.data.imageUrl)
        && (!('thumbUrl' in request.resource.data) || memeImg(request.resource.data.thumbUrl))
        && str(request.resource.data.get('sourceId', ''), 60)
        && str(request.resource.data.get('category', ''), 40)
        && str(request.resource.data.get('sourceDesc', ''), 300)
        && str(request.resource.data.top, 150)
        && str(request.resource.data.bottom, 150)
        && request.resource.data.top.size() + request.resource.data.bottom.size() > 0
        && request.resource.data.size is number
        && request.resource.data.size >= 0.6 && request.resource.data.size <= 1.5
        && (!('topPos' in request.resource.data) || validPos(request.resource.data.topPos))
        && (!('bottomPos' in request.resource.data) || validPos(request.resource.data.bottomPos))
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();

      // שופטים (מי שנכנס בקישור השיפוט): רואים רק ממים חדשים,
      // "מצחיק" = מעבירים ל"הורדו", "לא מצחיק" = מוחקים. רק מם שעדיין חדש
      allow read: if memesJudge() && resource.data.status == 'new';
      allow update: if memesJudge() && resource.data.status == 'new'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'judgedAt'])
        && request.resource.data.status == 'downloaded'
        && request.resource.data.judgedAt == request.time;
      allow delete: if memesJudge() && resource.data.status == 'new';
    }

    // קישור השיפוט: memes_judge/config = { enabled, token }. אדמין בלבד
    function memesJudgeCfg() {
      return get(/databases/$(database)/documents/memes_judge/config).data;
    }
    // שופט = משתמש (אנונימי) שרשם את הטוקן הנוכחי, והקישור פעיל.
    // איפוס הטוקן או השבתה מבטלים מיד את הגישה של כל השופטים הקודמים
    function memesJudge() {
      return request.auth != null
        && exists(/databases/$(database)/documents/memes_judges/$(request.auth.uid))
        && memesJudgeCfg().enabled == true
        && get(/databases/$(database)/documents/memes_judges/$(request.auth.uid)).data.token == memesJudgeCfg().token;
    }
    match /memes_judge/{d} {
      allow read, write: if isAdmin();
    }
    match /memes_judges/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'at'])
        && request.resource.data.token is string
        && memesJudgeCfg().enabled == true
        && request.resource.data.token == memesJudgeCfg().token;
      allow delete: if isAdmin();
    }

    // =================================================================
    //  תורנויות חדר (cheder) - אוספים שמתחילים ב-ch_
    //  ch_members/<מייל>: role = 'manager' (אחראי חדר, האדמין צירף) או 'resident'
    //  (דייר שהצטרף בקישור אישי). כל אחד רואה רק את החדר שלו.
    // =================================================================
    function chEmail() {
      return request.auth.token.email.lower();
    }
    function chPath() {
      return /databases/$(database)/documents/ch_members/$(chEmail());
    }
    function chMember() {
      return signedIn() && request.auth.token.email_verified == true && exists(chPath());
    }
    function chMe() {
      return get(chPath()).data;
    }
    function chRoom() {
      return chMe().room;
    }
    function chIsManager() {
      return chMe().get('role', 'manager') == 'manager';
    }
    // כל מי שבחדר (קריאה)
    function chInRoom(room) {
      return isAdmin() || (chMember() && chRoom() == room);
    }
    // אחראי החדר (כתיבה)
    function chManagerOf(room) {
      return isAdmin() || (chMember() && chRoom() == room && chIsManager());
    }
    function chResidentOf(room) {
      return chMember() && chRoom() == room && !chIsManager();
    }
    function chRooms(l, max) {
      return l is list && l.size() <= max;
    }
    function chInvitePath(t) {
      return /databases/$(database)/documents/ch_invites/$(t);
    }

    function chInv(t) {
      return get(chInvitePath(t)).data;
    }
    function chInvAfter(t) {
      return getAfter(chInvitePath(t)).data;
    }
    // הצטרפות דרך קישור: אישי (פעם אחת, לדייר מסוים) או קישור לכל החדר (בוחרים שם מהרשימה)
    function chJoinOk(m) {
      return m.invite is string
        && exists(chInvitePath(m.invite))
        && m.room == chInv(m.invite).room
        && (
          (chInv(m.invite).get('kind', 'person') == 'person'
            && chInv(m.invite).used == false
            && chInvAfter(m.invite).used == true
            && chInvAfter(m.invite).usedBy == chEmail()
            && m.rid == chInv(m.invite).rid)
          || (chInv(m.invite).get('kind', 'person') == 'room'
            && chInv(m.invite).active == true
            && m.rid is string
            && m.rid in chInv(m.invite).rids
            && !(m.rid in chInv(m.invite).get('taken', {}))
            && chInvAfter(m.invite).taken[m.rid] == chEmail())
        );
    }

    match /ch_members/{email} {
      allow get: if isAdmin() || (signedIn() && request.auth.token.email_verified == true && email == chEmail());
      // אחראי החדר רואה את מי שהצטרף לחדר שלו
      allow list: if isAdmin() || (chMember() && chIsManager() && resource.data.room == chRoom());
      allow create: if isAdmin()
        || (signedIn() && request.auth.token.email_verified == true
            && email == chEmail()
            && request.resource.data.keys().hasOnly(['email', 'name', 'room', 'role', 'rid', 'invite', 'addedAt'])
            && request.resource.data.email == chEmail()
            && request.resource.data.role == 'resident'
            && chJoinOk(request.resource.data));
      allow update: if isAdmin();
      // אחראי יכול להוציא דייר מהחדר שלו
      allow delete: if isAdmin()
        || (chMember() && chIsManager() && resource.data.room == chRoom() && resource.data.role == 'resident');
    }

    // קישורי הצטרפות. מי שיש לו את הקישור יכול לקרוא אותו (המזהה אקראי וארוך)
    //  kind 'person' (ברירת מחדל): לדייר אחד, פעם אחת
    //  kind 'room': לכל החדר. rids = מי עוד לא מחובר, names = השמות, taken = מי כבר נבחר
    match /ch_invites/{token} {
      allow get: if signedIn();
      allow list: if isAdmin() || (chMember() && chIsManager() && resource.data.room == chRoom());
      allow create: if chManagerOf(request.resource.data.room)
        && token.size() >= 16
        && request.resource.data.by == chEmail()
        && ((request.resource.data.keys().hasOnly(['room', 'rid', 'name', 'by', 'at', 'used'])
              && request.resource.data.used == false)
          || (request.resource.data.keys().hasOnly(['kind', 'room', 'rids', 'names', 'taken', 'active', 'by', 'at'])
              && request.resource.data.kind == 'room'
              && request.resource.data.taken.size() == 0));
      // האחראי מעדכן את הרשימה / משחרר שם / משבית
      allow update: if (chManagerOf(resource.data.room)
          && request.resource.data.room == resource.data.room
          && request.resource.data.get('kind', 'person') == resource.data.get('kind', 'person'))
        // מצטרף בקישור אישי: מסמן שנוצל
        || (signedIn() && request.auth.token.email_verified == true
            && resource.data.get('kind', 'person') == 'person'
            && resource.data.used == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
            && request.resource.data.used == true
            && request.resource.data.usedBy == chEmail()
            && existsAfter(chPath())
            && getAfter(chPath()).data.invite == token)
        // מצטרף בקישור לחדר: תופס שם אחד, את שלו
        || (signedIn() && request.auth.token.email_verified == true
            && resource.data.get('kind', 'person') == 'room'
            && resource.data.active == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taken'])
            && existsAfter(chPath())
            && getAfter(chPath()).data.invite == token
            && request.resource.data.taken.diff(resource.data.get('taken', {})).addedKeys().hasOnly([getAfter(chPath()).data.rid])
            && request.resource.data.taken.diff(resource.data.get('taken', {})).changedKeys().size() == 0
            && request.resource.data.taken.diff(resource.data.get('taken', {})).removedKeys().size() == 0
            && request.resource.data.taken[getAfter(chPath()).data.rid] == chEmail());
      allow delete: if chManagerOf(resource.data.room);
    }

    // החדר: דיירים, שינויים, הגדרות עצמאיות. כולם בחדר רואים, רק האחראי משנה
    match /ch_rooms/{room} {
      allow read: if chInRoom(room);
      allow write: if chManagerOf(room);

      // החלוקה של כל יום
      match /days/{day} {
        allow read: if chInRoom(room);
        allow write: if chManagerOf(room);
        // דייר: יכול לשמור את החלוקה המחושבת (בלי החלפות ידניות)...
        allow create: if chResidentOf(room)
          && request.resource.data.done.size() == 0
          && request.resource.data.manual.size() == 0;
        allow update: if chResidentOf(room) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tasks', 'present', 'assign', 'byPerson', 'dutyDate', 'at'])
          // ...ולסמן רק את המשימות שלו
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
              && request.resource.data.done.diff(resource.data.get('done', {})).affectedKeys()
                   .hasOnly(resource.data.get('byPerson', {}).get(chMe().rid, []).concat(['bed_' + chMe().rid]))));
      }

      // היעדרויות. דייר מסמן רק את עצמו
      match /absences/{id} {
        allow read: if chInRoom(room);
        allow write: if chManagerOf(room);
        allow create: if chResidentOf(room) && request.resource.data.rid == chMe().rid;
        allow update: if chResidentOf(room) && resource.data.rid == chMe().rid && request.resource.data.rid == chMe().rid;
        allow delete: if chResidentOf(room) && resource.data.rid == chMe().rid;
      }

      // תורנות שהחדר הזין רק לעצמו (גוברת על המשותפת)
      match /duties/{date} {
        allow read: if chInRoom(room);
        allow write: if chManagerOf(room);
      }
    }

    // מאגר משותף: תורנויות מהודעת המדריך. אחראי חדר מוסיף, כולם רואים, רק אדמין מוחק
    match /ch_duties/{date} {
      allow read: if isAdmin() || chMember();
      allow create, update: if isAdmin() || (chMember() && chIsManager()
        && request.resource.data.keys().hasOnly(['date', 'floor', 'kitchen', 'raw', 'time', 'sender', 'newRound', 'by', 'byRoom', 'at'])
        && request.resource.data.date == date
        && chRooms(request.resource.data.floor, 6)
        && chRooms(request.resource.data.kitchen, 3)
        && request.resource.data.get('raw', '') is string
        && request.resource.data.get('raw', '').size() <= 3000
        && request.resource.data.by == chEmail()
        && request.resource.data.byRoom == chRoom());
      allow delete: if isAdmin();
    }

    // מאגר משותף: חופשות, טיולים, העברת יום שטיפה... מי שהוסיף (או אדמין) עורך ומוחק
    match /ch_events/{id} {
      allow read: if isAdmin() || chMember();
      allow create: if isAdmin() || (chMember() && chIsManager()
        && request.resource.data.keys().hasOnly(['type', 'from', 'to', 'title', 'by', 'byRoom', 'at'])
        && request.resource.data.type in ['off', 'on', 'mopmove', 'mop', 'nomop', 'noduty', 'note']
        && request.resource.data.from is string
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() <= 80
        && request.resource.data.by == chEmail()
        && request.resource.data.byRoom == chRoom());
      allow update: if isAdmin();
      allow delete: if isAdmin() || (chMember() && chIsManager() && resource.data.byRoom == chRoom());
    }

    // הצעות שינוי בהגדרות למנהל. כל אחד בחדר מציע ורואה את ההצעות של החדר, רק אדמין מאשר
    match /ch_suggestions/{id} {
      allow read: if isAdmin() || (chMember() && resource.data.room == chRoom());
      allow create: if chMember()
        && request.resource.data.keys().hasOnly(['room', 'by', 'byName', 'kind', 'value', 'text', 'status', 'at'])
        && request.resource.data.room == chRoom()
        && request.resource.data.by == chEmail()
        && request.resource.data.status == 'open'
        && request.resource.data.kind in ['activeDays', 'mopDay', 'outside', 'other']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 400;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (chMember() && resource.data.by == chEmail() && resource.data.status == 'open');
    }

    // =================================================================
    //  צפייה משותפת (kupa-rashit) - kr_sync/<חדר>
    //  מצב הניגון של מי ששיתף: wall (רגע בשעון המשותף), abs (איפה התוכן היה), rate, paused.
    //  owner = המשתמש (האנונימי) שיצר את החדר. רק הוא משנה, rev עולה ב-1 בכל שינוי.
    //  מי שיש לו את הקישור (מזהה אקראי) קורא. אין רשימה של כל החדרים.
    //  peers: נוכחות - כל צופה מעדכן את עצמו כל 15 שניות (מתי + הסטייה שלו)
    // =================================================================
    function krState(d) {
      return d.keys().hasOnly(['v', 'owner', 'wall', 'abs', 'rate', 'paused', 'ended', 'rev', 'at'])
        && d.keys().hasAll(['v', 'owner', 'wall', 'abs', 'rate', 'paused', 'ended', 'rev', 'at'])
        && d.v == 3
        && d.owner == request.auth.uid
        && d.wall is number && d.abs is number
        && d.rate is number && d.rate >= 0.25 && d.rate <= 4
        && d.paused is bool && d.ended is bool
        && d.rev is int
        && d.at == request.time;
    }
    match /kr_sync/{room} {
      allow get: if true;
      allow create: if request.auth != null
        && room.matches('[A-Za-z0-9]{10,32}')
        && krState(request.resource.data)
        && request.resource.data.rev == 0
        && request.resource.data.ended == false;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && resource.data.ended == false
        && krState(request.resource.data)
        && request.resource.data.rev > resource.data.rev;

      match /peers/{pid} {
        allow read: if true;
        allow create, update: if pid.matches('[A-Za-z0-9]{8,32}')
          && request.resource.data.keys().hasOnly(['at', 'err', 'host'])
          && request.resource.data.keys().hasAll(['at', 'err', 'host'])
          && request.resource.data.at == request.time
          && request.resource.data.err is number
          && request.resource.data.err >= 0 && request.resource.data.err <= 3600000
          && request.resource.data.host is bool
          && exists(/databases/$(database)/documents/kr_sync/$(room));
        allow delete: if true;
      }
    }

    // כל השאר - אדמין בלבד
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
